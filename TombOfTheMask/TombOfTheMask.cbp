<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="TombOfTheMask" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/TombOfTheMask" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<ExtraCommands>
					<Add after='xcopy /E /I /Y "assets" "bin\Debug\assets"' />
					<Add after='xcopy /E /I /Y "levels" "bin\Debug\levels"' />
				</ExtraCommands>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/TombOfTheMask" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
				<ExtraCommands>
					<Add after='xcopy /E /I /Y "assets" "bin\Release\assets"' />
					<Add after='xcopy /E /I /Y "levels" "bin\Release\levels"' />
				</ExtraCommands>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-DUNICODE" />
			<Add option="-D_UNICODE" />
			<Add option="-DWIN32" />
